# API Keys for Talk With Zeno
# Copy this file to .env.local and fill in your actual API keys
# .env.local is gitignored and will not be committed

# Gemini API Key (for Gemini 2.5 Flash LLM and TTS fallback)
# Get your key from: https://aistudio.google.com/app/apikey
# Note: This is loaded directly in vite.config.ts, no VITE_ prefix needed
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for TTS - primary provider)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Speech-to-Text API Key
# Enable Speech-to-Text API in Google Cloud Console
# For frontend access, use VITE_ prefix
VITE_GOOGLE_STT_API_KEY=your_google_stt_api_key_here

# Google Text-to-Speech API Key (optional - Gemini TTS is used as fallback)
# Enable Cloud Text-to-Speech API in Google Cloud Console
VITE_GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Google OAuth Configuration (for user authentication)
# Get from: Google Cloud Console  APIs & Services  Credentials
# Create OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# SQLite Database Configuration
# Path to SQLite database file (for user identity storage)
# Default: data/zeno.db
DATABASE_PATH=./data/zeno.db

# Google Cloud Service Account (path to JSON credentials file)
# Download service account key from Google Cloud Console
# Place the JSON file in the project root and update this path
# Required for STT (Speech-to-Text)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json